# ======================================================================
# Sensitive values below go into Cloudflare as Secrets. EMAIL_BETA_ENABLED is a plain variable.
# Cloudflare dashboard -> Workers & Pages -> binglesignal -> Settings -> Variables and Secrets -> Add
# (For local testing only, copy this file to .dev.vars and fill it. Never commit .dev.vars.)
# ======================================================================

# --- Supabase (Project settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # master key: only here, never in /public or GitHub code

# --- Invited email beta ---
EMAIL_BETA_ENABLED=false
EMAIL_FORWARD_DOMAIN=in.binglesignal.com
CF_ZONE_ID=
CF_EMAIL_ROUTING_TOKEN=
CF_EMAIL_WORKER_NAME=
CLOUDFLARE_ACCOUNT_ID=                # GitHub Actions only, for public-story embeddings
CLOUDFLARE_API_TOKEN=                 # GitHub Actions only, Workers AI run permission
EMAIL_TOKEN_ENCRYPTION_KEY=         # legacy key only; keep until existing mailbox tokens have migrated
KEK_V1=                             # base64-encoded random 32-byte key; wraps each user's data key
KEK_CURRENT=v1                      # active KEK version identifier
GOOGLE_CLIENT_ID=                   # OAuth client for Gmail API
GOOGLE_CLIENT_SECRET=               # secret
GOOGLE_EMAIL_REDIRECT_URI=          # https://your-domain/api/email/oauth/gmail/callback
MICROSOFT_CLIENT_ID=                # OAuth app registration for Microsoft Graph
MICROSOFT_CLIENT_SECRET=            # secret
MICROSOFT_EMAIL_REDIRECT_URI=       # https://your-domain/api/email/oauth/outlook/callback
EMAIL_BETA_RETURN_URL=              # https://your-domain/#/email
EMAIL_AI_PROVIDER=openai_compatible # anthropic or openai_compatible
EMAIL_AI_ENDPOINT=                  # HTTPS OpenAI-compatible /v1/chat/completions endpoint (openai_compatible only)
EMAIL_AI_API_KEY=                   # secret; paid provider key, never for a free email-training tier
EMAIL_AI_MODEL=                     # provider model; Anthropic defaults to claude-haiku-5-5
EMAIL_AI_DAILY_TOKEN_CAP=100000     # per-user daily token budget
EMAIL_AI_MONTHLY_TOKEN_BUDGET=10000000 # global monthly token budget
EMAIL_AI_MONTHLY_BUDGET_EXCEEDED=false # emergency switch: true forces rules-only summaries
RESEND_API_KEY=                     # optional until email reports are enabled
EMAIL_FROM=                         # verified sender, e.g. BingleSignal <beta@your-domain>

# --- Briefing delivery ---
DELIVERY_EMAIL_PROVIDER=            # resend or ses
DELIVERY_FROM_EMAIL=                # address verified with the selected provider
DELIVERY_PHYSICAL_ADDRESS=          # legal mailing address for email footers
DELIVERY_UNSUBSCRIBE_SECRET=        # random secret used to sign unsubscribe links
PUBLIC_BASE_URL=                    # https://binglesignal.com
SES_REGION=                         # AWS region containing the verified SES identity
SES_ACCESS_KEY_ID=                  # IAM key restricted to ses:SendEmail
SES_SECRET_ACCESS_KEY=              # secret
SES_SESSION_TOKEN=                  # optional temporary AWS credential
TELEGRAM_BOT_TOKEN=                 # secret from Telegram BotFather
TELEGRAM_BOT_USERNAME=              # public bot username, without @
TELEGRAM_WEBHOOK_SECRET=            # random secret sent with Telegram webhook requests

# --- India: Razorpay (Dashboard -> Account & Settings -> API keys; Subscriptions -> Plans; Webhooks) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # you choose it when adding the webhook https://binglesignal.com/api/webhooks/razorpay
# USD Razorpay plan IDs; leave empty until payment-provider setup is approved.
RAZORPAY_PLAN_LITE_MONTHLY_USD=     # plan_xxx
RAZORPAY_PLAN_PRO_MONTHLY_USD=      # plan_xxx
RAZORPAY_PLAN_LITE_YEARLY_USD=      # plan_xxx
RAZORPAY_PLAN_PRO_YEARLY_USD=       # plan_xxx
# INR Razorpay plan IDs; create plans using the amounts configured in public/config.js.
RAZORPAY_PLAN_LITE_MONTHLY=         # plan_xxx
RAZORPAY_PLAN_PRO_MONTHLY=          # plan_xxx
RAZORPAY_PLAN_LITE_YEARLY=          # plan_xxx
RAZORPAY_PLAN_PRO_YEARLY=           # plan_xxx

# --- Worldwide: Dodo Payments (merchant of record: handles foreign VAT/sales tax) ---
# USD hosted checkout links; create plans using the amounts configured in public/config.js.
GLOBAL_WEBHOOK_SECRET=              # starts with whsec_ ; webhook URL https://binglesignal.com/api/webhooks/global
GLOBAL_LINK_LITE_MONTH=             # hosted checkout link for Lite monthly ($5)
GLOBAL_LINK_PRO_MONTH=              # Pro monthly ($11)
GLOBAL_LINK_LITE_YEAR=              # Lite yearly ($50)
GLOBAL_LINK_PRO_YEAR=               # Pro yearly ($110)
GLOBAL_LINK_PARAMS=                 # optional: how your provider wants email + user id added, default: email={email}&metadata_user_id={user_id}&metadata_plan={plan}
GLOBAL_PRODUCT_LITE_MONTH=          # product ID returned by the global provider for Lite monthly
GLOBAL_PRODUCT_PRO_MONTH=           # product ID returned by the global provider for Pro monthly
GLOBAL_PRODUCT_LITE_YEAR=           # product ID returned by the global provider for Lite yearly
GLOBAL_PRODUCT_PRO_YEAR=            # product ID returned by the global provider for Pro yearly
