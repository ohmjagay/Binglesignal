# ======================================================================
# Every value below goes into Cloudflare as a SECRET. Leave blank until you have it.
# Cloudflare dashboard -> Workers & Pages -> binglesignal -> Settings -> Variables and Secrets -> Add
# (For local testing only, copy this file to .dev.vars and fill it. Never commit .dev.vars.)
# ======================================================================

# --- Supabase (Project settings -> API) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # master key: only here, never in /public or GitHub code

# --- India: Razorpay (Dashboard -> Account & Settings -> API keys; Subscriptions -> Plans; Webhooks) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # you choose it when adding the webhook https://binglesignal.com/api/webhooks/razorpay
RAZORPAY_PLAN_LITE_MONTHLY=         # plan_xxx  (Rs 99)
RAZORPAY_PLAN_PRO_MONTHLY=          # plan_xxx  (Rs 299)
RAZORPAY_PLAN_LITE_YEARLY=          # plan_xxx  (Rs 999)
RAZORPAY_PLAN_PRO_YEARLY=           # plan_xxx  (Rs 2,999)

# --- Worldwide: Dodo Payments (merchant of record: handles foreign VAT/sales tax) ---
GLOBAL_WEBHOOK_SECRET=              # starts with whsec_ ; webhook URL https://binglesignal.com/api/webhooks/global
GLOBAL_LINK_LITE_MONTH=             # hosted checkout link for Lite monthly ($2.99)
GLOBAL_LINK_PRO_MONTH=              # Pro monthly ($5.99)
GLOBAL_LINK_LITE_YEAR=              # Lite yearly ($29)
GLOBAL_LINK_PRO_YEAR=               # Pro yearly ($59)
GLOBAL_LINK_PARAMS=                 # optional: how your provider wants email + user id added, default: email={email}&metadata_user_id={user_id}&metadata_plan={plan}
